# CloudDesk - copy to .env and edit. Placeholders only; never commit real values.
# Settings are cached: restart the server after changing this file.

# --- App ---
DEMO_MODE=true
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000
JWT_SECRET=change-me-demo-secret
SUPABASE_JWT_SECRET=

# --- Storage ---
DATABASE_URL=sqlite+aiosqlite:///./data/support.db
# postgresql+asyncpg://user:password@host:5432/dbname
CHECKPOINT_DB_PATH=./data/checkpoints.db
# :memory: in tests
REDIS_URL=
# empty -> fakeredis; redis://redis:6379/0 in containers
USE_FAKE_REDIS=false

# --- LLM / embeddings ---
LLM_PROVIDER=fake
LLM_API_KEY=
LLM_MODEL=
EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=384

# --- Vector store ---
VECTOR_STORE=memory
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=clouddesk_knowledge

# --- Policy / limits ---
APPROVAL_REQUIRED_FOR_REFUNDS=true
MAX_REFUND_WITHOUT_APPROVAL=0
TOOL_TIMEOUT_SECONDS=30
RATE_LIMIT_PER_MINUTE=120
SAMPLE_DATA_DIR=sample_data

# --- Observability (optional) ---
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=clouddesk-support
